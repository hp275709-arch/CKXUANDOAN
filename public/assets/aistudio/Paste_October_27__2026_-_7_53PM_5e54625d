                        <i class="fas fa-bars text-2xl"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Menu Navigation -->
        <div id="mobileMenu" class="hidden lg:hidden bg-white border-b border-gray-200 px-4 pt-2 pb-6 space-y-3">
            <div class="relative my-3">
                <input type="text" placeholder="Tìm kiếm sản phẩm..." class="w-full pl-9 pr-4 py-2 text-sm bg-gray-100 border border-gray-200 rounded-full">
                <i class="fas fa-search absolute left-3 top-3 text-gray-400 text-xs"></i>
            </div>
            <a href="#" class="block px-3 py-2 rounded-md font-bold text-green-ECO">Trang chủ</a>
            <a href="#about" class="block px-3 py-2 rounded-md text-navy-PRIMARY hover:bg-gray-100 font-semibold">Giới thiệu</a>
            <a href="#products" class="block px-3 py-2 rounded-md text-navy-PRIMARY hover:bg-gray-100 font-semibold">Vật liệu xây dựng</a>
            <a href="#solutions" class="block px-3 py-2 rounded-md text-navy-PRIMARY hover:bg-gray-100 font-semibold">Giải pháp xanh</a>
            <a href="#showrooms" class="block px-3 py-2 rounded-md text-navy-PRIMARY hover:bg-gray-100 font-semibold">Hệ thống Showroom</a>
            <a href="#contact" class="block px-3 py-2 rounded-md text-navy-PRIMARY hover:bg-gray-100 font-semibold">Liên hệ tư vấn</a>
