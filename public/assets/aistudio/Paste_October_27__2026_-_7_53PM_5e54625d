        // Material Calculator Functionality
        function calculateMaterial() {
            const length = parseFloat(document.getElementById('calcLength').value) || 0;
            const width = parseFloat(document.getElementById('calcWidth').value) || 0;
            const tileSize = parseFloat(document.getElementById('calcTileSize').value) || 1;

            const area = length * width;
            // +5% loss factor
            const requiredTiles = Math.ceil((area / tileSize) * 1.05);

            document.getElementById('calcArea').innerText = area.toFixed(1);
            document.getElementById('calcTilesCount').innerText = `${requiredTiles} tấm/viên`;
            showToast('Đã tính toán số lượng vật liệu ước tính thành công!');
        }

