        <section class="relative bg-navy-900 text-white min-h-[580px] flex items-center overflow-hidden">
            <!-- Background Image Overlay with Gradient -->
            <div class="absolute inset-0 bg-cover bg-center opacity-40 mix-blend-overlay" style="background-image: url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=1600&auto=format&fit=crop');"></div>
            <div class="absolute inset-0 bg-gradient-to-r from-navy-900 via-navy-PRIMARY/90 to-transparent"></div>
            
            <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 w-full">
                <div class="max-w-2xl">
                    <span class="inline-block bg-green-ECO/20 text-green-ECO border border-green-ECO/40 font-semibold text-xs tracking-widest uppercase px-3.5 py-1.5 rounded-full mb-4">
                        <i class="fas fa-leaf mr-1"></i> Tương lai cho công trình công nghệ xanh
                    </span>
                    <h1 class="font-heading font-extrabold text-3xl sm:text-5xl lg:text-6xl tracking-tight leading-tight mb-6">
                        Nâng Tầm Giá Trị Sống <br/>
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-green-ECO to-teal-300">Kiến Tạo Hệ Giải Pháp Xanh</span>
                    </h1>
                    <p class="text-gray-300 text-base sm:text-lg mb-8 leading-relaxed">
                        Tiên phong cung cấp giải pháp đồng bộ vật liệu xây dựng cao cấp: Đá nung kết khổ lớn, Kính tiết kiệm năng lượng Low-E, Sứ vệ sinh thông minh & Bê tông khí chưng áp ALC.
                    </p>
                    <div class="flex flex-wrap gap-4">
                        <a href="#products" class="bg-green-ECO hover:bg-green-DARK text-white font-heading font-bold text-sm px-8 py-3.5 rounded-lg shadow-lg hover:shadow-green-ECO/30 transition duration-300 flex items-center gap-2">
                            <span>Khám phá danh mục</span>
                            <i class="fas fa-arrow-right"></i>
                        </a>
                        <button onclick="downloadCatalogue()" class="bg-white/10 hover:bg-white/20 text-white border border-white/30 backdrop-blur-md font-heading font-bold text-sm px-8 py-3.5 rounded-lg transition duration-300 flex items-center gap-2">
                            <i class="fas fa-file-pdf text-red-400"></i>
                            <span>Tải E-Catalogues 2026</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Metric Highlights Banner at Bottom of Hero -->
            <div class="absolute bottom-0 inset-x-0 bg-navy-PRIMARY/80 backdrop-blur-md border-t border-white/10 hidden md:block">
                <div class="max-w-7xl mx-auto px-4 py-4 grid grid-cols-4 gap-4 text-center">
                    <div class="border-r border-white/10">
                        <p class="font-heading font-bold text-2xl text-green-ECO">50+</p>
                        <p class="text-xs text-gray-300 uppercase">Năm Uy Tín Hàng Đầu</p>
                    </div>
                    <div class="border-r border-white/10">
                        <p class="font-heading font-bold text-2xl text-green-ECO">40+</p>
                        <p class="text-xs text-gray-300 uppercase">Quốc Gia Xuất Khẩu</p>
                    </div>
                    <div class="border-r border-white/10">
                        <p class="font-heading font-bold text-2xl text-green-ECO">100%</p>
                        <p class="text-xs text-gray-300 uppercase">Đạt Chuẩn Xanh Quốc Tế</p>
                    </div>
                    <div>
                        <p class="font-heading font-bold text-2xl text-green-ECO">TOP 1</p>
                        <p class="text-xs text-gray-300 uppercase">Sản Xuất VLXD Tại Việt Nam</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Product Categories Filter & Grid Section -->
        <section id="products" class="py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
            <div class="text-center max-w-3xl mx-auto mb-12">
                <h2 class="text-xs font-bold uppercase tracking-widest text-green-ECO mb-2">Danh mục sản phẩm</h2>
                <p class="font-heading text-2xl sm:text-4xl font-extrabold text-navy-PRIMARY">Vật Liệu Xây Dựng Đột Phá & Đồng Bộ</p>
                <div class="w-16 h-1 bg-green-ECO mx-auto mt-4 rounded-full"></div>
            </div>

            <!-- Filter Buttons -->
            <div class="flex flex-wrap justify-center gap-2 sm:gap-3 mb-10" id="filterBtnGroup">
                <button onclick="filterProducts('all')" class="filter-btn active-filter bg-navy-PRIMARY text-white px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold transition shadow-sm">Tất cả sản phẩm</button>
                <button onclick="filterProducts('tile')" class="filter-btn bg-white hover:bg-gray-100 text-gray-700 border border-gray-200 px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold transition">Đá Nung Kết & Gạch</button>
                <button onclick="filterProducts('sanitary')" class="filter-btn bg-white hover:bg-gray-100 text-gray-700 border border-gray-200 px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold transition">Sứ Vệ Sinh & Sen Vòi</button>
                <button onclick="filterProducts('glass')" class="filter-btn bg-white hover:bg-gray-100 text-gray-700 border border-gray-200 px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold transition">Kính Tiết Kiệm Năng Lượng</button>
                <button onclick="filterProducts('concrete')" class="filter-btn bg-white hover:bg-gray-100 text-gray-700 border border-gray-200 px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold transition">Bê Tông Khí ALC & Ngói</button>
            </div>

            <!-- Product Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8" id="productGrid">
                <!-- Product items rendered dynamically via JS -->
            </div>
        </section>

        <!-- Green Solutions & Eco Technology -->
        <section id="solutions" class="bg-navy-900 text-white py-16 relative overflow-hidden">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                    <div>
                        <span class="text-green-ECO font-bold text-xs uppercase tracking-widest block mb-2"><i class="fas fa-leaf mr-1"></i> Xu Hướng Xanh 2026</span>
                        <h2 class="font-heading text-3xl sm:text-4xl font-extrabold mb-6 leading-tight">Giải Pháp Công Trình Xanh & Bảo Vệ Môi Trường</h2>
                        <p class="text-gray-300 mb-8 leading-relaxed">
                            Viglacera là doanh nghiệp tiên phong cam kết phát triển bền vững, ứng dụng công nghệ Châu Âu để giảm thiểu phát thải Carbon, tiết kiệm năng lượng vận hành cho các công trình hiện đại.
                        </p>
                        
                        <div class="space-y-6">
                            <div class="flex items-start gap-4">
                                <div class="w-12 h-12 rounded-xl bg-green-ECO/20 border border-green-ECO/30 flex items-center justify-center text-green-ECO text-xl flex-shrink-0">
                                    <i class="fas fa-bolt"></i>
                                </div>
                                <div>
                                    <h3 class="font-heading font-bold text-lg text-white">Kính Tiết Kiệm Năng Lượng Low-E / Solar Control</h3>
                                    <p class="text-sm text-gray-400">Cản đến 79% bức xạ nhiệt mặt trời, giảm tải 50% chi phí điện điều hòa cho tòa nhà cao tầng.</p>
                                </div>
                            </div>

                            <div class="flex items-start gap-4">
                                <div class="w-12 h-12 rounded-xl bg-green-ECO/20 border border-green-ECO/30 flex items-center justify-center text-green-ECO text-xl flex-shrink-0">
                                    <i class="fas fa-cubes"></i>
                                </div>
                                <div>
                                    <h3 class="font-heading font-bold text-lg text-white">Bê Tông Khí Chưng Áp ALC siêu nhẹ</h3>
                                    <p class="text-sm text-gray-400">Thi công nhanh gấp 3 lần, cách âm, cách nhiệt tiêu chuẩn Châu Âu và tái chế 100% tài nguyên.</p>
                                </div>
                            </div>

                            <div class="flex items-start gap-4">
                                <div class="w-12 h-12 rounded-xl bg-green-ECO/20 border border-green-ECO/30 flex items-center justify-center text-green-ECO text-xl flex-shrink-0">
                                    <i class="fas fa-shower"></i>
                                </div>
                                <div>
                                    <h3 class="font-heading font-bold text-lg text-white">Sứ Vệ Sinh Men Nano Anti-bacterial</h3>
                                    <p class="text-sm text-gray-400">Kháng khuẩn đến 89%, xả xoáy siêu tiết kiệm nước chỉ với 3.5L/lần xả.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="relative">
                        <div class="aspect-video rounded-2xl overflow-hidden shadow-2xl border border-white/10">
                            <img src="https://images.unsplash.com/photo-1513694203232-719a280e022f?q=80&w=1200&auto=format&fit=crop" alt="Green Architecture Solutions" class="w-full h-full object-cover">
                        </div>
                        <div class="absolute -bottom-6 -left-6 bg-green-ECO text-white p-6 rounded-2xl shadow-xl hidden sm:block max-w-xs">
                            <p class="font-heading font-extrabold text-3xl">40%</p>
                            <p class="text-xs uppercase font-medium mt-1">Tiết kiệm năng lượng cho các công trình đạt chứng chỉ LEED & Lotus</p>
                        </div>
                    </div>
                </div>
            </div>
