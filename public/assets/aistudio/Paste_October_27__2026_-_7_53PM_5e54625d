    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter & Montserrat -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        navy: {
                            800: '#002548',
                            900: '#001A33',
                            PRIMARY: '#003366',
                        },
                        green: {
                            ECO: '#00a859',
                            DARK: '#008545',
                        },
                        stone: {
                            BG: '#f8f9fa',
                            CARD: '#ffffff',
                        }
                    },
                    fontFamily: {
                        sans: ['Roboto', 'sans-serif'],
                        heading: ['Montserrat', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Roboto', sans-serif;
        }
        h1, h2, h3, h4, h5, h6, .font-heading {
            font-family: 'Montserrat', sans-serif;
        }
        .bg-pattern {
            background-image: radial-gradient(#003366 0.5px, transparent 0.5px), radial-gradient(#003366 0.5px, #f8f9fa 0.5px);
            background-size: 20px 20px;
            background-position: 0 0, 10px 10px;
            opacity: 0.05;
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }
        ::-webkit-scrollbar-thumb {
            background: #003366;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #002548;
        }
    </style>
</head>
<body class="bg-stone-BG text-gray-800 antialiased flex flex-col min-h-screen">

