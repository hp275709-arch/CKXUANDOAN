        <!-- Material Estimator Tool Section -->
        <section id="calculator" class="py-16 bg-gray-50 px-4 sm:px-6 lg:px-8">
            <div class="max-w-5xl mx-auto bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden">
                <div class="bg-navy-PRIMARY p-6 text-white text-center">
                    <h2 class="font-heading text-2xl font-bold">Công Cụ Tính Nhu Cầu Vật Liệu Dự Án</h2>
                    <p class="text-xs text-gray-300 mt-1">Dễ dàng ước tính số lượng gạch, đá ốp lát cần dùng cho không gian của bạn</p>
                </div>
                
                <div class="p-6 sm:p-10 grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
                    <div class="space-y-4">
                        <div>
                            <label class="block text-xs font-bold uppercase text-gray-700 mb-1">Chiều dài diện tích (m)</label>
                            <input type="number" id="calcLength" value="5" min="0.5" step="0.5" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-navy-PRIMARY focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase text-gray-700 mb-1">Chiều rộng diện tích (m)</label>
                            <input type="number" id="calcWidth" value="4" min="0.5" step="0.5" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-navy-PRIMARY focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase text-gray-700 mb-1">Kích thước gạch/đá mong muốn</label>
                            <select id="calcTileSize" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-navy-PRIMARY focus:outline-none">
                                <option value="0.36">60x60 cm (Định dạng tiêu chuẩn)</option>
                                <option value="0.64">80x80 cm (Định dạng vừa)</option>
                                <option value="1.44">120x120 cm (Khổ lớn Granit)</option>
                                <option value="3.84" selected>160x240 cm (Đá Nung Kết Khổ Tấm)</option>
                            </select>
                        </div>
                        <button onclick="calculateMaterial()" class="w-full bg-navy-PRIMARY hover:bg-navy-800 text-white font-bold py-3.5 rounded-lg transition shadow-md">
                            <i class="fas fa-calculator mr-2"></i>Tính Toán Ngay
                        </button>
                    </div>

                    <div class="bg-stone-BG p-6 rounded-xl border border-gray-200 text-center flex flex-col justify-center h-full">
                        <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Kết quả dự toán</span>
                        <div class="mt-4">
                            <span class="text-4xl font-extrabold text-green-ECO" id="calcArea">20</span>
                            <span class="text-gray-600 font-semibold">m²</span>
                        </div>
                        <p class="text-xs text-gray-500 mt-1">Tổng diện tích bề mặt</p>

                        <div class="mt-6 pt-6 border-t border-gray-200">
                            <p class="text-xs text-gray-500 uppercase font-semibold">Số lượng tấm/viên ước tính (+5% hao hụt):</p>
                            <p class="text-3xl font-bold text-navy-PRIMARY mt-2" id="calcTilesCount">6 tấm</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Showrooms & Dealer Network Locator -->
